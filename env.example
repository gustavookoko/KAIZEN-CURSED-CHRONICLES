# Nunca comite o .env real. No Render, configure DATABASE_URL nas Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Para PostgreSQL local sem TLS, use disable. No Render, deixe ausente para usar TLS.
# PGSSLMODE=disable
PGPOOL_MAX=10
PORT=3000
# Só para a ferramenta de migração. Caminho para o accounts.json ORIGINAL, se disponível.
# JSON_SOURCE_FILE=./data/accounts.json
